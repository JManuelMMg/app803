<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos para Botones del Login -->
    <style name="LoginButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">25dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Estilos para TextInputLayout -->
    <style name="LoginTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/colorPrimary</item>
    </style>

    <!-- Estilos para CardView del Logo -->
    <style name="LoginLogoCardStyle" parent="CardView">
        <item name="cardCornerRadius">60dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
    </style>

    <!-- Animación de Fade In -->
    <style name="LoginFadeInAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

</resources>

