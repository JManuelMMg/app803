<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_menu">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL ADMINISTRATIVO"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/font_menu"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estadísticas de Reservaciones"
            android:textSize="14sp"
            android:textColor="#DDF4FF"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal" />

    <!-- Contenido scrollable -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:spacing="12dp">

            <!-- Tarjeta 1: Totales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dashboard_card"
                android:padding="16dp"
                style="@style/CardView">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 TOTALES"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvTotalReservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total de Reservaciones: 0"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTotalUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total de Usuarios: 0"
                    android:textSize="14sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <!-- Tarjeta 2: Reservaciones por Mes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dashboard_card"
                android:padding="16dp"
                style="@style/CardView">

                <TextView
                    android:id="@+id/tvReservacionesPorMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 Reservaciones por Mes:\n"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartMeses"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Tarjeta 3: Eventos Populares -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dashboard_card"
                android:padding="16dp"
                style="@style/CardView">

                <TextView
                    android:id="@+id/tvEventosPopulares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎉 Eventos Más Populares:\n"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartEventos"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Tarjeta 4: Lugares Populares -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dashboard_card"
                android:padding="16dp"
                style="@style/CardView">

                <TextView
                    android:id="@+id/tvLugaresPopulares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Lugares Más Reservados:\n"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartLugares"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dashboard_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOcupacionEventos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ocupación por evento:\n"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartOcupacion"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Espacio adicional -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>

    </ScrollView>

    <!-- Botón Volver -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="VOLVER"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#E45050"
        android:layout_margin="16dp" />

</LinearLayout>

