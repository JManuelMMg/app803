<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_menu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:background="@drawable/res_header">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel Administrativo"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/font_menu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Indicadores generales del sistema de reservaciones"
            android:fontFamily="@font/font_menu"
            android:textSize="13sp"
            android:textColor="#D8F4F0"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_panel_premium"
                android:paddingStart="22dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:elevation="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen"
                    android:fontFamily="@font/font_menu"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#12313B"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="64dp"
                    android:layout_height="4dp"
                    android:background="@drawable/res_card_topline"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/res_stat_tile">

                        <TextView
                            android:id="@+id/tvTotalReservaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_menu"
                            android:text="Total de reservaciones: 0"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#12313B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/res_stat_tile"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/tvTotalUsuarios"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_menu"
                            android:text="Total de usuarios: 0"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#12313B" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_panel_premium"
                android:paddingStart="22dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:elevation="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvReservacionesPorMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reservaciones por mes"
                    android:fontFamily="@font/font_menu"
                    android:textSize="14sp"
                    android:textColor="#314253"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartMeses"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_panel_premium"
                android:paddingStart="22dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:elevation="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvEventosPopulares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_menu"
                    android:text="Eventos más populares"
                    android:textSize="14sp"
                    android:textColor="#314253"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartEventos"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_panel_premium"
                android:paddingStart="22dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:elevation="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvLugaresPopulares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_menu"
                    android:text="Lugares más reservados"
                    android:textSize="14sp"
                    android:textColor="#314253"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartLugares"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_panel_premium"
                android:paddingStart="22dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:elevation="8dp">

                <TextView
                    android:id="@+id/tvOcupacionEventos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_menu"
                    android:text="Ocupación por evento"
                    android:textSize="14sp"
                    android:textColor="#314253"
                    android:lineSpacingExtra="4dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartOcupacion"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_panel_premium"
                android:paddingStart="22dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:elevation="8dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvReservasPorUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_menu"
                    android:text="Reservas por evento y usuario"
                    android:textSize="14sp"
                    android:textColor="#314253"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:fontFamily="@font/font_menu"
        android:text="VOLVER"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/res_button_danger"
        android:backgroundTint="@null"
        android:elevation="3dp"
        android:layout_margin="16dp" />
</LinearLayout>
