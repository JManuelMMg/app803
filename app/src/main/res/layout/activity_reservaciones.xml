<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/back_menu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:background="@drawable/res_header">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eventos y Reservaciones"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/font_menu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta tus eventos y administra solicitudes según tu rol"
            android:textSize="13sp"
            android:textColor="#D8F4F0"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvCatalogoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eventos disponibles"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_menu" />

            <TextView
                android:id="@+id/tvEventosEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="18dp"
                android:text="No hay eventos publicados en el catálogo"
                android:gravity="center"
                android:textColor="#65D0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/res_empty_state"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvReservacionesTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mis reservaciones"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_menu" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="22dp"
                android:text="No hay reservaciones disponibles"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_menu"
                android:textColor="#65D0FF"
                android:background="@drawable/res_empty_state"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@drawable/res_action_bar"
        android:elevation="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acciones rápidas"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#496171"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/reservaciones"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ACTUALIZAR LISTA"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/res_button_primary"
            android:backgroundTint="@null"
            android:elevation="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCrearReservacion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="NUEVA RESERVA"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#12313B"
                android:background="@drawable/res_button_secondary"
                android:backgroundTint="@null"
                android:elevation="2dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDashboard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="VER DASHBOARD"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#12313B"
                android:background="@drawable/res_button_secondary"
                android:backgroundTint="@null"
                android:elevation="2dp"
                android:layout_marginStart="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CERRAR SESIÓN"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/res_button_danger"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>
