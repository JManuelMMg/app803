<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_menu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:background="@drawable/res_header">

        <TextView
            android:id="@+id/tvTituloFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva Reservación"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/font_menu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa los detalles para agendar tu evento"
            android:textSize="13sp"
            android:textColor="#D8F4F0"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/panel_surface"
            android:elevation="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Información del evento"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#12313B"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="64dp"
                android:layout_height="4dp"
                android:background="@drawable/res_card_topline"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/layoutUsuarioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID de usuario para reservación manual"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#244657"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etUsuarioIdAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/res_input"
                    android:hint="Ej. 2"
                    android:inputType="number"
                    android:padding="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de evento *"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spTipoEvento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/res_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:entries="@array/tipos_evento"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del evento *"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEvento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/res_input"
                android:hint="Ej. Conferencia de tecnología"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#A8A7A7"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha del evento *"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/etFecha"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="2026-06-15"
                    android:padding="12dp"
                    android:background="@drawable/res_input"
                    android:textColor="#0F172A"
                    android:textColorHint="#7B8A99"
                    android:inputType="text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSeleccionarFecha"
                    android:layout_width="72dp"
                    android:layout_height="52dp"
                    android:text="FECHA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#12313B"
                    android:background="@drawable/res_button_secondary"
                    android:backgroundTint="@null"
                    android:elevation="2dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Seleccionar fecha" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lugar *"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etLugar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ej. Auditorio principal"
                android:padding="12dp"
                android:background="@drawable/res_input"
                android:textColor="#0F172A"
                android:textColorHint="#7B8A99"
                android:inputType="textCapSentences"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cantidad de lugares *"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCantidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="1"
                android:text="1"
                android:padding="12dp"
                android:background="@drawable/res_input"
                android:textColor="#0F172A"
                android:textColorHint="#7B8A99"
                android:inputType="number"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:hint="Añade detalles útiles para los asistentes"
                android:padding="12dp"
                android:background="@drawable/res_input"
                android:textColor="#0F172A"
                android:textColorHint="#7B8A99"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/res_action_bar"
        android:elevation="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="CANCELAR"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/res_button_danger"
            android:backgroundTint="@null"
            android:elevation="2dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGuardar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="GUARDAR"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/res_button_primary"
            android:backgroundTint="@null"
            android:elevation="3dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>
</LinearLayout>
