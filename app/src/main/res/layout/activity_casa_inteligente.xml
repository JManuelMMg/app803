<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2D0526"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠 Casa Inteligente"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de dispositivos del hogar"
            android:textSize="16sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- LUCES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Iluminación"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnLuzSala"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sala"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FFA500" />

                <Button
                    android:id="@+id/btnLuzCocina"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cocina"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FFD700" />

                <Button
                    android:id="@+id/btnLuzDormitorio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dormitorio"
                    android:backgroundTint="#87CEEB" />
            </LinearLayout>
        </LinearLayout>

        <!-- TEMPERATURA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️ Aire Acondicionado"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/btnReducirTemp"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="−"
                    android:textSize="24sp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="#4169E1" />

                <TextView
                    android:id="@+id/txtTemperatura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22°C"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/btnAumentarTemp"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:backgroundTint="#FF6347" />
            </LinearLayout>
        </LinearLayout>

        <!-- SEGURIDAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Seguridad"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnBloquearPuertas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚪 Puertas"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#DC143C" />

                <Button
                    android:id="@+id/btnActivarAlarma"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚨 Alarma"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FF1493" />

                <Button
                    android:id="@+id/btnCamaras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📹 Cámaras"
                    android:backgroundTint="#32CD32" />
            </LinearLayout>
        </LinearLayout>

        <!-- ENTRETENIMIENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Entretenimiento"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Televisor"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#9370DB" />

                <Button
                    android:id="@+id/btnMusica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Música"
                    android:backgroundTint="#20B2AA" />
            </LinearLayout>
        </LinearLayout>

        <!-- ESTADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Estado del Sistema"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Sistema funcionando correctamente"
                android:textSize="14sp"
                android:textColor="#90EE90"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnActualizarEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Actualizar Estado"
                android:backgroundTint="#1E90FF" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
