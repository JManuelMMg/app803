<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Anillo rotatorio grande (visible detrás del logo) -->
    <ImageView
        android:id="@+id/splash_ring"
        android:layout_width="390dp"
        android:layout_height="390dp"
        android:layout_gravity="center"
        android:src="@drawable/shape_ring"
        android:alpha="0.18"
        android:contentDescription="@null" />

    <!-- Onda radial pulsante -->
    <ImageView
        android:id="@+id/splash_wave"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:src="@drawable/splash_wave"
        android:alpha="0.0"
        android:contentDescription="@null" />

    <!-- Contenedor central con VideoView pequeño centrado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- VideoView reducido al centro, rodeado por los anillos decorativos -->
        <VideoView
            android:id="@+id/splash_logo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@string/splash_logo_desc"
            android:alpha="0"
            android:keepScreenOn="true" />

        <!-- Texto del app debajo del video -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_menu"
            android:layout_marginTop="32dp"
            android:text="BIENVENID@"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/md_green_100"
            android:alpha="1"
            android:textStyle="bold"
            android:textSize="30dp" />

    </LinearLayout>

</FrameLayout>
