<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Decoración: anillo rotatorio detrás del logo -->
    <ImageView
        android:id="@+id/splash_ring"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:src="@drawable/shape_ring"
        android:alpha="0.18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@string/splash_logo_desc"
            android:src="@drawable/img"
            android:scaleType="centerInside"
            android:alpha="0" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="AppJuan803"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/md_green_700"
            android:alpha="0"
            android:textStyle="bold"
            android:textSize="18sp" />

    </LinearLayout>

</FrameLayout>

