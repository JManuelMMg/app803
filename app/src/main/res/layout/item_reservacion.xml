<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="7dp"
        app:cardBackgroundColor="#FFFFFFFF"
        app:strokeColor="#BFD6E4"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/res_card_premium"
                android:padding="16dp">

            <View
                android:layout_width="72dp"
                android:layout_height="4dp"
                android:background="@drawable/res_card_topline"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvTipoEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conferencia"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0F766E"
                android:background="@drawable/res_chip"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Evento"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#12313B"
                android:fontFamily="@font/font_menu"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha: 2026-06-15"
                android:textSize="14sp"
                android:textColor="#3E5265"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/tvLugar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lugar: Auditorio principal"
                android:textSize="14sp"
                android:textColor="#3E5265"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lugares reservados: 1"
                android:textSize="13sp"
                android:textColor="#12313B"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/tvUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente: usuario@correo.com"
                android:textSize="13sp"
                android:textColor="#0F766E"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción del evento"
                android:textSize="13sp"
                android:textColor="#475569"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/res_surface_alt"
                android:padding="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEditar"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="EDITAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/res_button_secondary"
                    android:backgroundTint="@null"
                    android:textColor="#12313B"
                    android:elevation="2dp"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEliminar"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="ELIMINAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/res_button_danger"
                    android:backgroundTint="@null"
                    android:textColor="@android:color/white"
                    android:elevation="2dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
