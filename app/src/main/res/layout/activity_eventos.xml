<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_menu"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="620dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:background="@drawable/res_panel_premium"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservaciones"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/res_login_badge"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:letterSpacing="0" />

            <TextView
                android:id="@+id/tvTituloAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INICIAR SESIÓN"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0B2630"
                android:fontFamily="@font/font_menu"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvSubtituloAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accede para consultar y agendar tus eventos"
                android:textSize="14sp"
                android:textColor="#4B6170"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp" />

            <View
                android:layout_width="56dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/res_card_topline"
                android:layout_marginBottom="22dp" />

            <LinearLayout
                android:id="@+id/containerNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#244657"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Ej. Juan Pérez"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="12dp"
                    android:background="@drawable/res_input"
                    android:textColor="#0F172A"
                    android:textColorHint="#7B8A99" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="correo@ejemplo.com"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:background="@drawable/res_input"
                android:textColor="#0F172A"
                android:textColorHint="#7B8A99"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#244657"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Mínimo 6 caracteres"
                android:inputType="textPassword"
                android:padding="12dp"
                android:background="@drawable/res_input"
                android:textColor="#0F172A"
                android:textColorHint="#7B8A99"
                android:layout_marginBottom="18dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="INICIAR SESIÓN"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/res_button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="CREAR CUENTA NUEVA"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#12313B"
                android:background="@drawable/res_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:layout_marginTop="10dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
