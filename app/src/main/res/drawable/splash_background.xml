<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient base: azul profundo -> violeta -> magenta (más moderno) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D47A1"
                android:centerColor="#3949AB"
                android:endColor="#7B1FA2"
                android:angle="270" />
        </shape>
    </item>

    <!-- Radial vignette para enfocar centro -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450"
                android:centerX="50%"
                android:centerY="40%"
                android:startColor="#00000000"
                android:endColor="#66000000" />
        </shape>
    </item>
</layer-list>

