<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
         <shape>
             <solid android:color="#D1D5DB" />
             <stroke
                 android:width="1dp"
                 android:color="#9CA3AF" />
             <corners android:radius="8dp" />
         </shape>
     </item>
    <item android:state_pressed="true">
         <shape>
             <gradient
                 android:startColor="#E0F2FE"
                 android:centerColor="#BAE6FD"
                 android:endColor="#7DD3C0"
                 android:angle="90" />
             <stroke
                 android:width="2dp"
                 android:color="#0D9488" />
             <corners android:radius="8dp" />
         </shape>
     </item>
    <item>
         <shape>
             <gradient
                 android:startColor="#F0F9FF"
                 android:centerColor="#E0F2FE"
                 android:endColor="#CFFAFE"
                 android:angle="90" />
             <stroke
                 android:width="2dp"
                 android:color="#7DD3C0" />
             <corners android:radius="8dp" />
         </shape>
     </item>
</selector>
