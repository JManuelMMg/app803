<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
         <layer-list>
             <item>
                 <shape>
                     <solid android:color="#9CA3AF" />
                     <corners android:radius="8dp" />
                 </shape>
             </item>
         </layer-list>
     </item>
    <item android:state_pressed="true">
         <layer-list>
             <item>
                 <shape>
                     <gradient
                         android:startColor="#087E8B"
                         android:centerColor="#0891B2"
                         android:endColor="#0284C7"
                         android:angle="90" />
                     <stroke
                         android:width="2dp"
                         android:color="#06536D" />
                     <corners android:radius="8dp" />
                 </shape>
             </item>
         </layer-list>
     </item>
    <item>
         <layer-list>
             <item>
                 <shape>
                     <gradient
                         android:startColor="#0D9488"
                         android:centerColor="#06B6D4"
                         android:endColor="#0EA5E9"
                         android:angle="90" />
                     <stroke
                         android:width="2dp"
                         android:color="#087E8B" />
                     <corners android:radius="8dp" />
                 </shape>
             </item>
         </layer-list>
     </item>
</selector>
